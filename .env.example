# 复制这个文件，改名为 .env，再填入你自己的密钥。.env 不会被上传（见 .gitignore）。

# 旁白配音：火山引擎「豆包语音」控制台里的 API Key（不是访问控制的 AK/SK）
VOLC_SPEECH_API_KEY=

# 写实镜头：MiniMax 开放平台国内站的 API Key（档位 ②，可选）
MINIMAX_API_KEY=

# AI 配乐、音效：ElevenLabs 的 API Key（可选）
ELEVENLABS_API_KEY=

# 访问海外服务需要代理的话填，例如 http://127.0.0.1:7890；国内服务不走它
HTTPS_PROXY=

# 飞书进度简报发给谁：你自己的飞书 open_id（可选，需要先配好 lark-cli）
FEISHU_USER_OPEN_ID=
